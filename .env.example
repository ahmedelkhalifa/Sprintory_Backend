#Give every key a value - an empty one defeats its default and can fail startup.
#On the VPS this file is deploy/.env. Production values that differ from local:
#  COOKIE_SECURE=true, FRONTEND_URL=https://real-domain, a real SMTP provider instead of Mailpit.
#  DB_URL, DB_USERNAME, DB_PASSWORD and SPRING_PROFILES_ACTIVE are set by deploy/docker-compose.yml - leave them out there.

#Database
DB_URL=
DB_USERNAME=
DB_PASSWORD=

#JWT & Cookies
COOKIE_SECURE=
JWT_SECRET=

#Cors
FRONTEND_URL=

#Google sign-in - paths are on the frontend app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH2_SUCCESS_PATH=
OAUTH2_FAILURE_PATH=

#Mail
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=
MAIL_SMTP_STARTTLS=
MAIL_FROM=

#Emailed links - routes on the frontend app that receive ?token=
VERIFY_EMAIL_PATH=
RESET_PASSWORD_PATH=
INVITE_PATH=

#Dev admin seed - resolved only under the dev profile, no defaults on purpose
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

#Profile
SPRING_PROFILES_ACTIVE=

#Docker compose (VPS only) - backend image on Docker Hub and the Postgres container's database
BACKEND_IMAGE=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=